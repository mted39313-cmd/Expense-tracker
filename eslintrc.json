{
  "env": {
    "browser": true, /* Enables browser globals like window, document, fetch */
    "es2022": true, /* Enables modern ES2022 syntax features */
    "node": true, /* Enables Node.js globals */
    "jest": true /* Enables Jest testing globals like describe, test, expect */
  },
  "extends": "eslint:recommended", /* Uses ESLint's recommended rule set */
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }] /* Warns on unused variables, ignoring variables starting with underscore */
  }
}