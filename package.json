    "test": "NODE_OPTIONS=--experimental-vm-modules jest", /* Command to run Jest unit tests with ES module support */
    "lint": "eslint src/ tests/" /* Command to run ESLint static analysis across source and test directories */
  },
  "devDependencies": {
    "eslint": "^8.57.0", /* Linter package for checking code style and errors */
    "jest": "^29.7.0" /* Testing framework package */
  }
}